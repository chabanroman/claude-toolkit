#!/usr/bin/env bash
# git commit-msg hook: strip Claude attribution so commits are authored by me only.
# Removes "Co-Authored-By: Claude…", "Claude-Session:…" and "Generated with Claude Code" lines,
# then trailing blank lines. Installed per repo by `claude-hook-enable`.

msg_file="$1"
tmp="$(mktemp)"

grep -viE '^(co-authored-by:.*(claude|anthropic)|claude-session:|.*generated with \[?claude code)' "$msg_file" > "$tmp"

# Drop trailing blank lines left behind by the removed trailers.
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n = n - 1; for (i = 1; i <= n; i = i + 1) print lines[i] }' "$tmp" > "$msg_file"
rm -f "$tmp"

# Chain to a repo hook that was already there before this one was installed.
prev="$(dirname "$0")/commit-msg.local"
if [ -x "$prev" ]; then
  exec "$prev" "$@"
fi
