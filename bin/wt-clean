#!/usr/bin/env bash
# wt-clean — remove worktrees under ../<repo>-wt/ whose branch is merged into the default branch
# and that have no uncommitted changes. Prints what it would do; pass --yes to actually remove.
set -euo pipefail

yes="${1:-}"
repo="$(git rev-parse --show-toplevel)"
root="$(dirname "$repo")/$(basename "$repo")-wt"
base="${WT_BASE:-$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo main)}"

git fetch --quiet origin 2>/dev/null || true
merged="$(git branch --format='%(refname:short)' --merged "$base")"

git worktree list --porcelain | awk '/^worktree /{ print substr($0, 10) }' | while read -r dir; do
  case "$dir" in "$root"/*) ;; *) continue ;; esac
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
  if ! printf '%s\n' "$merged" | grep -qx "$branch"; then
    echo "keep   $dir ($branch not merged into $base)"
    continue
  fi
  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    echo "keep   $dir (uncommitted changes)"
    continue
  fi
  if [ "$yes" = "--yes" ]; then
    git worktree remove "$dir"
    git branch -d "$branch"
    echo "removed $dir ($branch)"
  else
    echo "remove $dir ($branch) — rerun with --yes"
  fi
done
git worktree prune
