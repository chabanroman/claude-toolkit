#!/usr/bin/env bash
# wt <TICKET-ID> [slug] — a separate worktree + Claude session for one ticket, so several run in parallel.
#   wt CDP-123              → ../<repo>-wt/cdp-123,          branch cdp-123
#   wt CDP-123 fix-filters  → ../<repo>-wt/cdp-123-fix-filters, branch cdp-123-fix-filters
# Installs deps, then starts Claude there with Remote Control on (reachable from the phone).
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: wt <TICKET-ID> [slug]" >&2
  exit 1
fi

ticket="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
name="$ticket${2:+-$2}"

repo="$(git rev-parse --show-toplevel)"
dir="$(dirname "$repo")/$(basename "$repo")-wt/$name"

if [ ! -d "$dir" ]; then
  base="${WT_BASE:-$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)}"
  git fetch --quiet origin 2>/dev/null || true
  if git show-ref --verify --quiet "refs/heads/$name"; then
    git worktree add "$dir" "$name"
  else
    git worktree add -b "$name" "$dir" "$base"
  fi
  # Untracked local config the worktree still needs.
  for f in .env .env.local .claude/settings.local.json; do
    if [ -f "$repo/$f" ]; then
      mkdir -p "$dir/$(dirname "$f")"
      cp "$repo/$f" "$dir/$f"
    fi
  done
  cd "$dir"
  if [ -f yarn.lock ]; then yarn install --frozen-lockfile
  elif [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile
  elif [ -f package-lock.json ]; then npm ci
  fi
fi

cd "$dir"
exec claude --remote-control "$name" "/pickup $1"
